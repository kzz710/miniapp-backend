# ===== 买车决策小程序 · 后端环境变量模板 =====
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交密钥。
# 生产环境建议把真实配置放在项目目录之外，例如 /etc/miniapp/miniapp.env（chmod 600），
# 由 systemd 的 EnvironmentFile 注入，项目目录内不放任何密钥文件。

# ---------- LLM 后端 ----------
# doubao  = 火山引擎方舟，内置联网搜索，只需一个 key（推荐）
# deepseek= OpenAI 兼容接口（需另配搜索源 Bocha/Tavily）
LLM_PROVIDER=doubao

# 豆包 / 火山方舟 API Key（即 ARK_API_KEY）：https://console.volcengine.com/ark
DOUBAO_API_KEY=
# 默认模型支持联网搜索与工具调用；可在方舟控制台替换为指定推理接入点(ep-xxxx)或版本
DOUBAO_MODEL=doubao-seed-1.6-250615

# DeepSeek（仅在 LLM_PROVIDER=deepseek 时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 检索源（仅 LLM_PROVIDER=deepseek 时需要）----------
# bocha = 博查 Web Search API（国内，推荐）；tavily = 海外备选；mock = 离线
SEARCH_PROVIDER=mock
BOCHA_API_KEY=
TAVILY_API_KEY=

# ---------- 用户系统 ----------
# 四端登录密钥只写本机 .env 或服务器 EnvironmentFile，不要写入本文件以外的可提交文件。
# 未配某端 Secret 时的降级：
#   - 该端 *_MOCK_LOGIN=true：强制 mock（openid 可用 *_MOCK_OPENID 固定，便于联调）
#   - 微信未配 WX_APPID/WX_SECRET：沿用现网，自动降级 mock（仅限开发）
#   - 抖音/快手/百度未配密钥：JWT 仍为默认值时自动 mock；生产已换 JWT 时返回 503「xx 端登录未配置」
# 跳过真实 code2session（openid 由 code 派生）。仅本地开发用 true，生产必须 false。
WX_MOCK_LOGIN=false
# 可选：mock 模式固定 openid，让本地/真机调试始终登录同一账号
# （小程序登录 code 每次不同，不设此项则每次登录都会新建用户）
WX_MOCK_OPENID=

# 微信小程序登录（微信公众平台 → 开发管理 → 开发设置）
# 说明：AppID 会随小程序包公开，可提交；AppSecret 是机密，只能写进 .env，
#      绝不要写在本文件、源码、README 或任何会被提交的地方。
# 已确认 AppID：wx7262c0605d2bf998
WX_APPID=
WX_SECRET=

# 抖音小程序（platform=toutiao），已确认 AppID：ttc78cb13158a68335
TT_APPID=
TT_SECRET=
TT_MOCK_LOGIN=false
TT_MOCK_OPENID=

# 快手小程序（platform=kuaishou），已确认 AppID：ks702843020083943663
KS_APPID=
KS_SECRET=
KS_MOCK_LOGIN=false
KS_MOCK_OPENID=

# 百度智能小程序（platform=baidu）
# BD_APPID 应填控制台 AppKey（换票参数 client_id），不一定是数字 AppID 15297539，待核对后再写 .env。
BD_APPID=
BD_SECRET=
BD_MOCK_LOGIN=false
BD_MOCK_OPENID=

# JWT 签名密钥：生产环境必须替换为随机串（如 openssl rand -hex 32）。
# 未替换且已配置微信凭据时，服务启动会直接报错拒绝运行。
JWT_SECRET=dev-only-change-me-in-production
TOKEN_TTL_DAYS=30

# 登录接口限流：同一 IP 每分钟最多登录次数（0 表示不限制）
LOGIN_RATE_LIMIT_PER_MINUTE=20

# 数据库：本地默认 SQLite；生产建议 MySQL，例如
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/miniapp?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db

# 发布 / 审批每日上限（按北京时间自然日计算）
POST_DAILY_LIMIT=5
REVIEW_DAILY_LIMIT=20

# ---------- 其他 ----------
CACHE_TTL=86400          # 车价缓存 TTL（秒），默认 24 小时
PORT=8000                # 服务端口
