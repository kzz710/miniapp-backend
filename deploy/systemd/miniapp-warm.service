[Unit]
Description=Warm car price cache (hot keywords)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/miniapp-backend
Environment="PATH=/opt/miniapp-backend/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/miniapp/miniapp.env
# 5 个车型联网取价约 2~4 分钟，留足超时
TimeoutStartSec=600
ExecStart=/opt/miniapp-backend/.venv/bin/python -m app.scripts.warm_cache
